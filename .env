# ─────────────────────────────────────────────
#  APPLICATION                          OPTIONAL
# ─────────────────────────────────────────────
APP_NAME=EnterpriseApp
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins — no spaces
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200


# ─────────────────────────────────────────────
#  MONGODB                               REQUIRED
# ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/enterprise_db
MONGO_POOL_MIN=5
MONGO_POOL_MAX=20
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000


# ─────────────────────────────────────────────
#  REDIS                                OPTIONAL
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=enterprise:
# Default TTL for cached items (seconds) — 3600 = 1 hour
REDIS_DEFAULT_TTL=3600


# ─────────────────────────────────────────────
#  RABBITMQ                              REQUIRED
# ─────────────────────────────────────────────
RABBITMQ_URI=amqp://guest:guest@localhost:5672
# Exchange settings — OPTIONAL
RABBITMQ_EXCHANGE=enterprise.exchange
RABBITMQ_EXCHANGE_TYPE=topic
# Max unacknowledged messages per consumer
RABBITMQ_PREFETCH=10


# ─────────────────────────────────────────────
#  KEYCLOAK  (Authentication only)      REQUIRED
#
#  Keycloak verifies WHO the user is (identity).
#  It does NOT control what they can do (that is
#  handled by the external Authorisation API below).
# ─────────────────────────────────────────────
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=enterprise-realm
KEYCLOAK_CLIENT_ID=enterprise-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret


# ─────────────────────────────────────────────
#  EXTERNAL AUTHORISATION API           REQUIRED
#
#  Separate service that resolves WHAT the user
#  can do (permissions / roles).
#
#  Expected endpoint:
#    GET {AUTHZ_API_BASE_URL}/users/{userId}/permissions
#
#  Expected response:
#    { userId, roles: string[], permissions: string[] }
#
#  Results are cached in Redis for AUTHZ_PERMISSIONS_TTL_SEC
#  seconds to keep every API response under 100 ms.
# ─────────────────────────────────────────────
AUTHZ_API_BASE_URL=http://localhost:4000
AUTHZ_API_KEY=your-authz-api-key
# Hard timeout for the AuthZ API call (ms) — OPTIONAL
AUTHZ_API_TIMEOUT_MS=3000
# How long to trust cached permissions (seconds) — OPTIONAL
# 300 = 5 minutes. Lower = fresher permissions, more API calls.
AUTHZ_PERMISSIONS_TTL_SEC=300


# ─────────────────────────────────────────────
#  RATE LIMITING                        OPTIONAL
# ─────────────────────────────────────────────
# Window size in milliseconds — 900000 = 15 minutes
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP within the window
RATE_LIMIT_MAX_REQUESTS=100


# ─────────────────────────────────────────────
#  LOGGING                              OPTIONAL
# ─────────────────────────────────────────────
# Levels: error | warn | info | http | debug
LOG_LEVEL=debug
LOG_DIR=logs