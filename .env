# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MongoDB
MONGO_URI=mongodb://localhost:27017/EHR
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT=5000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Sur$$072025
MYSQL_DATABASE=user_management
MYSQL_CONNECTION_LIMIT=10
MYSQL_ACQUIRE_TIMEOUT=60000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=5000

# Cache
CACHE_ROLES_TTL_SECONDS=86400

# Keycloak / Auth
KEYCLOAK_JWKS_URI=https://dev-auth.dragarwal.com/auth/realms/master/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://dev-auth.dragarwal.com/auth/realms/master
JWT_ALGORITHMS=RS256

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
